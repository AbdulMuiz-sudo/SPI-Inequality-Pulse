# Python & Environments
__pycache__/
*.pyc
.env
.venv/
.vscode/

# Databricks & System
.databricks/
.DS_Store
Thumbs.db

# Office / Excel temporary lock files
~$*.xlsx

# Ignore all files inside raw WFP (large bulk data)
data/raw/wfp/*
!data/raw/wfp/.gitkeep

# Raw PBS: Keep the directory and ignore non-Excel junk, but track fetched reports
data/raw/pbs/*
!data/raw/pbs/.gitkeep
!data/raw/pbs/*.xlsx

# Ignore all CSVs globally (blocks full WFP downloads & local temp files)
*.csv

# EXCEPTIONS: Allow small test samples in samples folders
!data/samples/*.csv
!data/samples/**/*.csv